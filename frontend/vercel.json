{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://greenticker-hrms-7v4w.vercel.app/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://greenticker-hrms-7v4w.vercel.app/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
